<div class="toolbar">
  <h1><%= @table.name %></h1>
  <%= link_to "← tables", database_path(@database, anchor: "tables") %>
</div>

<% seconds_elapsed = @table.seconds_since_reset %>

<section>
  <h2>cache performance</h2>
  <table>
    <tbody>
      <tr>
        <th>heap cache hit</th>
        <td><%= format_percentage(@table.heap_cache_hit_ratio) %></td>
      </tr>
      <tr>
        <th>index cache hit</th>
        <td><%= format_percentage(@table.index_cache_hit_ratio) %></td>
      </tr>
      <tr>
        <th>toast cache hit</th>
        <td><%= format_percentage(@table.toast_cache_hit_ratio) %></td>
      </tr>
      <tr>
        <th>toast index cache hit</th>
        <td><%= format_percentage(@table.toast_index_cache_hit_ratio) %></td>
      </tr>
    </tbody>
  </table>
</section>

<section>
  <h2>row activity</h2>
  <table>
    <tbody>
      <tr>
        <th>estimated rows</th>
        <td><%= format_number(@table.row_estimate) %></td>
      </tr>
      <tr>
        <th>sequential scans</th>
        <td>
          <%= format_number(@table.seq_scan) %>
          <% if @table.seq_scan_percentage %><span class="dim">(<%= @table.seq_scan_percentage %>%)</span><% end %>
        </td>
      </tr>
      <tr>
        <th>index scans</th>
        <td>
          <%= format_number(@table.idx_scan) %>
          <% if @table.idx_scan_percentage %><span class="dim">(<%= @table.idx_scan_percentage %>%)</span><% end %>
        </td>
      </tr>
      <tr>
        <th>index usage</th>
        <td><%= format_percentage(@table.index_usage_percentage) %></td>
      </tr>
      <tr>
        <th>rows fetched</th>
        <td><%= format_count_with_rate(@table.rows_fetched, seconds_elapsed) %></td>
      </tr>
      <tr>
        <th>rows inserted</th>
        <td><%= format_count_with_rate(@table.rows_inserted, seconds_elapsed) %></td>
      </tr>
      <tr>
        <th>rows updated</th>
        <td><%= format_count_with_rate(@table.rows_updated, seconds_elapsed) %></td>
      </tr>
      <tr>
        <th>rows deleted</th>
        <td><%= format_count_with_rate(@table.rows_deleted, seconds_elapsed) %></td>
      </tr>
      <tr>
        <th>live tuples</th>
        <td><%= format_number(@table.live_tuples) %></td>
      </tr>
      <tr>
        <th>dead tuples</th>
        <td>
          <%= format_number(@table.dead_tuples) %>
          <% if @table.dead_tuple_ratio %><span class="dim">(<%= @table.dead_tuple_ratio %>% of total)</span><% end %>
          <% if @table.dead_tuple_warning? %><br><span class="warn">consider running VACUUM</span><% end %>
        </td>
      </tr>
    </tbody>
  </table>
</section>

<section>
  <h2>maintenance</h2>
  <table>
    <tbody>
      <tr>
        <th>last vacuum</th>
        <td><%= format_time_ago(@table.last_vacuum) %></td>
      </tr>
      <tr>
        <th>last autovacuum</th>
        <td><%= format_time_ago(@table.last_autovacuum) %></td>
      </tr>
      <tr>
        <th>last analyze</th>
        <td><%= format_time_ago(@table.last_analyze) %></td>
      </tr>
      <tr>
        <th>last autoanalyze</th>
        <td><%= format_time_ago(@table.last_autoanalyze) %></td>
      </tr>
      <tr>
        <th>vacuum count</th>
        <td><%= format_number(@table.vacuum_count) %></td>
      </tr>
      <tr>
        <th>autovacuum count</th>
        <td><%= format_number(@table.autovacuum_count) %></td>
      </tr>
      <tr>
        <th>analyze count</th>
        <td><%= format_number(@table.analyze_count) %></td>
      </tr>
      <tr>
        <th>autoanalyze count</th>
        <td><%= format_number(@table.autoanalyze_count) %></td>
      </tr>
    </tbody>
  </table>
</section>
