<%# Draws any report. Pass columns: [keys], rows: [subset] and/or limit: n to show a projection. %>
<% columns = local_assigns[:columns] ? report.columns.select { |c| local_assigns[:columns].include?(c.key) } : report.columns %>
<% rows = local_assigns[:rows] || report.rows %>
<% rows = rows.first(local_assigns[:limit]) if local_assigns[:limit] %>
<div class="scroll">
  <table>
    <thead>
      <tr>
        <% columns.each do |column| %>
          <th class="<%= cell_class(column) %>" <%= "title=#{column.title.inspect}".html_safe if column.title %>>
            <%= column.header %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr <%= "data-filter-value=#{row.value(report.columns.first).to_s.downcase.inspect}".html_safe %>>
          <% columns.each do |column| %>
            <td class="<%= cell_class(column) %>">
              <% if local_assigns[:link] && column.key == local_assigns[:link_column] %>
                <%= link_to format_cell(report, column, row), local_assigns[:link].call(row) %>
              <% else %>
                <%= format_cell(report, column, row) %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
