<h1>Databases</h1>

<%# An empty list means one of two quite different things, and the engine knows
    which: PostgreSQL databases exist but none is mapped to a connection class,
    or there are no PostgreSQL databases to show at all. %>
<% if @configured_databases.empty? && @databases.any? %>
  <article aria-label="No database connections configured">
    <header>pg_peek has no database connections configured</header>
    <p>
      Found <%= pluralize(@databases.size, "PostgreSQL database") %> in
      <code>config/database.yml</code>
      (<%= safe_join(@databases.map { |database| content_tag(:code, database.name) }, ", ") %>),
      but <code>config.pg_peek.connections</code> is empty, so none of them can be opened.
    </p>
    <p>Generate the initializer:</p>
    <pre><code>bin/rails generate pg_peek:install</code></pre>
    <p>Or add <code>config/initializers/pg_peek.rb</code> yourself:</p>
    <pre><code>Rails.application.config.pg_peek.tap do |config|
  config.connections = {
<%= @databases.map { |database|
      klass = database.primary ? "ApplicationRecord" : "#{database.name.camelize}Record"
      %(    "#{database.name}" => "#{klass}")
    }.join(",\n") %>
  }
end</code></pre>
  </article>
<% elsif @databases.empty? %>
  <article aria-label="No PostgreSQL databases">
    <header>No PostgreSQL databases found</header>
    <p>
      No entry in <code>config/database.yml</code> for the
      <code><%= Rails.env %></code> environment uses the
      <code>postgresql</code> adapter, so there is nothing for pg_peek to inspect.
    </p>
  </article>
<% end %>

<div class="grid">
  <% @configured_databases.each do |database| %>
    <div>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" height="64">
        <!--!Font Awesome Free v7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
        <path d="M544 269.8C529.2 279.6 512.2 287.5 494.5 293.8C447.5 310.6 385.8 320 320 320C254.2 320 192.4 310.5 145.5 293.8C127.9 287.5 110.8 279.6 96 269.8L96 352C96 396.2 196.3 432 320 432C443.7 432 544 396.2 544 352L544 269.8zM544 192L544 144C544 99.8 443.7 64 320 64C196.3 64 96 99.8 96 144L96 192C96 236.2 196.3 272 320 272C443.7 272 544 236.2 544 192zM494.5 453.8C447.6 470.5 385.9 480 320 480C254.1 480 192.4 470.5 145.5 453.8C127.9 447.5 110.8 439.6 96 429.8L96 496C96 540.2 196.3 576 320 576C443.7 576 544 540.2 544 496L544 429.8C529.2 439.6 512.2 447.5 494.5 453.8z"/>
      </svg>

      version: <%= database.version %>
      <br>

      <%= link_to database.name, database_path(database) %> |
        <% if Rails.application.config.pg_peek.stats_provider == :pg_stat_statements %>
          <%= link_to 'pg_stat_statements', database_pg_stat_statements_path(database) %>
        <% end %>

      <% if Rails.application.config.pg_peek.stats_provider == :pg_stat_monitor %>
        pg_stat_monitor (TODO)
      <% end %>

    </div>
  <% end %>
</div>
