<h1><%= @database.name %> <small class="dim">overview</small></h1>

<p class="vitals dim">
  <span>postgres <%= @database.version %></span>
  <% if @pg_stat_statements.usable? %>
    <span>pg_stat_statements <%= @pg_stat_statements.installed_version %></span>
    <span><%= stats_since_link(@database, @stats_reset_at) %></span>
    <span><%= pluralize(number_with_delimiter(@pg_stat_statements.statement_count), "statement") %></span>
  <% end %>
  <% if @vitals["cache_hit_ratio"] %><span>cache hit <%= @vitals["cache_hit_ratio"] %>%</span><% end %>
  <% if @vitals["connections"] %><span><%= pluralize(@vitals["connections"].to_i, "connection") %></span><% end %>
</p>

<% if @pg_stat_statements.usable? %>
<% elsif @pg_stat_statements.installed? %>
  <%= render "pg_peek/pg_stat_statements/preload_instructions",
             database: @database,
             pg_stat_statements: @pg_stat_statements %>
<% elsif @pg_stat_statements.available? %>
  <article aria-label="Extension pg_stat_statements is not enabled">
    <header>pg_stat_statements extension is not enabled</header>
    <p>Create it with a migration, so it is tracked in your schema:</p>
    <% if @database.primary %>
      <pre><code>bin/rails generate migration EnablePgStatStatements</code></pre>
    <% else %>
      <pre><code>bin/rails generate migration EnablePgStatStatements --database <%= @database.name %></code></pre>
    <% end %>
    <pre><code>def change
  enable_extension "pg_stat_statements"
end</code></pre>
    <p>Then <code>bin/rails db:migrate</code>.</p>
  </article>
<% else %>
  <article aria-label="Extension pg_stat_statements is not available">
    <header>pg_stat_statements extension is not available</header>
    <p>The pg_stat_statements extension is not available on this PostgreSQL server.</p>
    <p>To make it available, add to <code>postgresql.conf</code>:</p>
    <pre><code>shared_preload_libraries = 'pg_stat_statements'</code></pre>
    <footer>
      <small>A server restart is required after this change.</small>
    </footer>
  </article>
<% end %>

<div class="panels">
  <section class="wide">
    <h2>attention</h2>
    <ul class="attention">
      <% if @attention.empty? %>
        <li class="ok">nothing needs attention</li>
      <% else %>
        <% @attention.each do |item| %>
          <li><%= item[:href] ? link_to(item[:text], item[:href]) : item[:text] %></li>
        <% end %>
      <% end %>
    </ul>
  </section>

  <% if @pg_stat_statements.usable? %>
    <section>
      <h2>endpoints <%= link_to "all →", database_endpoints_path(@database) %></h2>
      <% if @endpoints.empty? %>
        <p class="dim">No endpoint has run a query yet.</p>
      <% else %>
        <%= render "pg_peek/reports/report", report: @endpoints,
                   columns: %i[endpoint share total_exec_time_ms max_queries_per_request],
                   limit: PgPeek::DatabasesController::OVERVIEW_ROWS %>
      <% end %>
    </section>

    <section>
      <h2>jobs <%= link_to "all →", database_jobs_path(@database) %></h2>
      <% if @jobs.empty? %>
        <p class="dim">No job has run a query yet.</p>
      <% else %>
        <%= render "pg_peek/reports/report", report: @jobs,
                   columns: %i[job_class share total_exec_time_ms],
                   limit: PgPeek::DatabasesController::OVERVIEW_ROWS %>
      <% end %>
    </section>

    <section class="wide">
      <h2>slowest queries <%= link_to "all →", database_queries_path(@database) %></h2>
      <% if @queries.empty? %>
        <p class="dim">No statements recorded yet.</p>
      <% else %>
        <%= render "pg_peek/reports/report", report: @queries, limit: PgPeek::DatabasesController::OVERVIEW_ROWS %>
      <% end %>
    </section>
  <% end %>

  <section class="wide">
    <h2>activity <%= link_to "now →", database_activity_path(@database) %></h2>
    <p class="vitals dim">
      <span><%= @connection_summary["client_connections"] %> of <%= @connection_summary["max_connections"] %> server connections in use</span>
      <span>this database: <%= @sessions.active.size %> active</span>
      <span><%= @sessions.in_transaction.size %> idle in transaction</span>
      <span><%= @sessions.idle.size %> idle</span>
      <% if @sessions.blocked.any? %><span><%= @sessions.blocked.size %> blocked</span><% end %>
    </p>
    <% if @sessions.busy.any? %>
      <%= render "pg_peek/reports/report", report: @sessions, rows: @sessions.busy,
                 limit: PgPeek::DatabasesController::OVERVIEW_ROWS %>
    <% end %>
  </section>

  <section class="wide" id="tables" data-filter>
    <h2>tables (<%= @tables.rows.size %>)</h2>
    <input type="search"
           placeholder="filter tables… (press / to focus)"
           data-filter-input
           data-filter-noun="table"
           autocomplete="off">
    <p class="dim" data-filter-count></p>

    <%= render "pg_peek/reports/report",
               report: @tables,
               link_column: :name,
               link: ->(row) { database_table_path(@database, row["name"]) } %>

    <p class="dim" data-filter-empty hidden>No tables match that filter.</p>
  </section>
</div>

<% if @pg_stat_statements.usable? %>
  <section id="pg_stat_statements">
    <h2>pg_stat_statements <%= @pg_stat_statements.installed_version %></h2>
    <p class="dim">
      Queries, endpoints and jobs are cumulative since
      <%= @stats_reset_at.strftime("%Y-%m-%d %H:%M:%S %Z") %> (<%= format_time_ago(@stats_reset_at) %>),
      <%= pluralize(number_with_delimiter(@pg_stat_statements.statement_count), "statement") %> tracked.
      A reset starts a fresh window: exact counts and attribution, at the
      price of the history so far.
      <% peers = @database.server_peers %>
      <% if peers.any? %>
        It also clears <%= peers.map(&:name).to_sentence %>, which
        <%= peers.one? ? "shares" : "share" %> this server: PostgreSQL keeps
        one reset time for all of them.
      <% end %>
    </p>
    <%= button_to "reset statistics",
                  reset_database_pg_stat_statements_path(@database),
                  method: :delete,
                  class: "danger",
                  disabled: !@pg_stat_statements.resettable?,
                  form_class: "inline",
                  form: { data: { confirm: "Reset pg_stat_statements? This clears statement statistics for every database on this server." } } %>
    <% unless @pg_stat_statements.resettable? %>
      <p class="dim">
        <%= @connection_summary["username"] %> may not reset the statistics: the extension
        allows it only to superusers and roles granted it. To allow it:
      </p>
      <pre><code>GRANT EXECUTE ON FUNCTION pg_stat_statements_reset TO <%= @connection_summary["username"] %>;</code></pre>
    <% end %>
    <% if @pg_stat_statements.outdated? %>
      <p class="dim">
        Version <%= @pg_stat_statements.default_version %> is available:
        <code>ALTER EXTENSION pg_stat_statements UPDATE;</code>
      </p>
    <% end %>
  </section>
<% end %>

<details>
  <summary>database details</summary>
  <pre>name: <%= @database.name %>
primary: <%= @database.primary %>
replica: <%= @database.replica %>
schema_format: <%= @database.schema_format %>
version: <%= @database.version_full %></pre>
</details>

<details>
  <summary>installed extensions</summary>
  <pre><% @database.installed_extensions.each do |extension| %><%= extension['name'] %> <%= extension['installed_version'] %>
<% end %></pre>
</details>
