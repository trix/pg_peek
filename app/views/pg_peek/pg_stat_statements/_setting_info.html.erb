<%# locals: (setting:) %>
<details class="info">
  <summary aria-label="About <%= setting.full_name %>" title="what this setting does">i</summary>
  <div class="about">
    <p><%= setting.does %></p>
    <% if setting.values.any? %>
      <dl>
        <% setting.values.each do |value, meaning| %>
          <dt><code><%= value %></code></dt>
          <dd><%= meaning %></dd>
        <% end %>
      </dl>
    <% elsif setting.range %>
      <p>
        From <%= number_with_delimiter(setting.range.first) %>
        to <%= number_with_delimiter(setting.range.last) %>.
      </p>
    <% end %>
    <p class="dim">
      Default <code><%= setting.default %></code>.
      To change it: <%= setting.change %>.
      <% if setting.pending_restart? %>
        <span class="warn">A new value is waiting for a restart.</span>
      <% end %>
    </p>
  </div>
</details>
