<% reset_at = @pg_stat_statements.reset_at %>
<% settings = @pg_stat_statements.settings %>
<% dealloc = @pg_stat_statements.dealloc %>

<div class="toolbar">
  <h1>pg_stat_statements <small class="dim"><%= @pg_stat_statements.installed_version %></small></h1>
</div>

<section>
  <h2>collection</h2>
  <table>
    <tbody>
      <tr>
        <th>stats since</th>
        <td><%= reset_at.strftime("%Y-%m-%d %H:%M:%S %Z") %> (<%= format_time_ago(reset_at) %>)</td>
      </tr>
      <tr>
        <th>statements tracked</th>
        <td>
          <%= number_with_delimiter(@pg_stat_statements.server_statement_count) %>
          <% if settings["max"] %>of <%= number_with_delimiter(settings["max"].to_i) %><% end %>
          <span class="dim">(this database: <%= number_with_delimiter(@pg_stat_statements.statement_count) %>)</span>
        </td>
      </tr>
      <tr>
        <th>dropped when full</th>
        <td><%= number_with_delimiter(dealloc) %></td>
      </tr>
    </tbody>
  </table>
  <% if dealloc.positive? %>
    <p class="dim">
      The server dropped statements to make room since the last reset, so every
      total here undercounts. Raise <code>pg_stat_statements.max</code>
      (needs a server restart) or reset more often.
    </p>
  <% end %>
</section>

<section id="settings">
  <h2>settings</h2>
  <table>
    <tbody>
      <% settings.each do |name, value| %>
        <tr>
          <th><code>pg_stat_statements.<%= name %></code></th>
          <td><%= value %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @pg_stat_statements.outdated? %>
    <p class="dim">
      Version <%= @pg_stat_statements.default_version %> is available:
      <code>ALTER EXTENSION pg_stat_statements UPDATE;</code>
    </p>
  <% end %>
</section>

<section id="reset">
  <h2>reset</h2>
  <p class="dim">
    Queries, endpoints and jobs are cumulative since the last reset. A reset
    starts a fresh window: exact counts and attribution, at the price of the
    history so far. Restarting PostgreSQL clears them too.
    <% peers = @database.server_peers %>
    <% if peers.any? %>
      It also clears <%= peers.map(&:name).to_sentence %>, which
      <%= peers.one? ? "shares" : "share" %> this server: PostgreSQL keeps
      one reset time for all of them.
    <% end %>
  </p>
  <%= button_to "reset statistics",
                reset_database_pg_stat_statements_path(@database),
                method: :delete,
                class: "danger",
                disabled: !@pg_stat_statements.resettable?,
                form_class: "inline",
                form: { data: { confirm: "Reset pg_stat_statements? This clears statement statistics for every database on this server." } } %>
  <% unless @pg_stat_statements.resettable? %>
    <p class="dim">
      <%= @connection_summary["username"] %> may not reset the statistics: the extension
      allows it only to superusers and roles granted it. To allow it:
    </p>
    <pre><code>GRANT EXECUTE ON FUNCTION pg_stat_statements_reset TO <%= @connection_summary["username"] %>;</code></pre>
  <% end %>
</section>
