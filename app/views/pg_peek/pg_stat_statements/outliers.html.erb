<div class="toolbar">
  <h1>pg_stat_statements</h1>
  <%= button_to "reset statistics",
                reset_database_pg_stat_statements_path("primary"),
                method: :delete,
                class: "danger",
                form_class: "inline",
                form: { data: { confirm: "Reset pg_stat_statements? This clears all collected statement statistics." } } %>
</div>

<% if flash[:notice] %>
  <p class="notice"><%= flash[:notice] %></p>
<% end %>

<details>
  <summary>environment</summary>
  <pre>query_log_tags_enabled:               <%= @query_log_tags_enabled %>
query_log_tags_format:                <%= @query_log_tags_format %>
query_log_tags:                       <%= @query_log_tags %>
query_log_tags_prepend_comment:       <%= @query_log_tags_prepend_comment %>

pg_stat_statements_reset_at:          <%= @pg_stat_statements.reset_at %>
pg_stat_statements_installed_version: <%= @pg_stat_statements.installed_version %>
pg_stat_statements_default_version:   <%= @pg_stat_statements.default_version %></pre>
</details>

<h1>Outliers</h1>

<% if @outliers.present? %>
  <% max_calls = @outliers.map { |o| o["ncalls"].to_s.gsub(/[^0-9]/, "").to_i }.max %>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th title="Call intensity">calls</th>
          <th>time</th>
          <th>query</th>
          <th title="SQLcommenter metadata"></th>
        </tr>
      </thead>
      <tbody>
        <% @outliers.each do |outlier| %>
          <% comment = extract_comment(outlier["query"]) %>
          <% calls_num = outlier["ncalls"].to_s.gsub(/[^0-9]/, "").to_i %>
          <tr>
            <td class="intensity" title="<%= outlier["ncalls"] %> calls">
              <%= intensity_bar(calls_num, max_calls) %>
            </td>
            <td class="nowrap stack">
              <div><strong><%= format_duration(outlier["total_exec_time"]) %></strong></div>
              <div class="dim"><%= outlier["prop_exec_time"] %></div>
              <div class="dim">avg <%= outlier["avg_exec_ms"] %>ms</div>
            </td>
            <td>
              <code class="sql"><%= strip_sqlcommenter(outlier["query"]).squish %></code>
            </td>
            <td class="dim">
              <% if comment %>
                <% comment_text = sqlcommenter_to_hash(comment).map { |k, v| "#{k}: #{CGI.unescape(v.to_s.gsub(/^'|'$/, ''))}" }.join("\n") %>
                <span title="<%= comment_text %>">◆</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="dim">No outliers found.</p>
<% end %>

<details>
  <summary>sqlcommenter patterns for this application</summary>
  <% @controllers_actions.each do |controller, actions| %>
    <% actions.each do |action| %>
      <p class="dim"><%= controller %>#<%= action %></p>
      <pre>$$%/*action='<%= action %>',application='<%= @application %>',namespaced_controller='<%= ERB::Util.url_encode(controller) %>'*/%$$</pre>
    <% end %>
  <% end %>
</details>
