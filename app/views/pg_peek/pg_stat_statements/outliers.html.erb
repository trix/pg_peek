<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
  <h1 style="margin: 0;">pg_stat_statements</h1>
  <%= button_to "Reset",
                reset_database_pg_stat_statements_path("primary"),
                method: :delete,
                data: {
                  confirm: "Are you sure you want to reset pg_stat_statements? This will clear all statement statistics."
                },
                class: "btn btn-danger",
                style: "padding: 8px 16px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 14px;" %>
</div>

<% if flash[:notice] %>
  <div style="padding: 10px; margin-bottom: 20px; background-color: #d4edda; border: 1px solid #c3e6cb; color: #155724; border-radius: 4px;">
    <%= flash[:notice] %>
  </div>
<% end %>

<details>
  <summary>Rails Environment</summary>
  <pre>
  query_log_tags_enabled:               <%= @query_log_tags_enabled %>
  query_log_tags_format:                <%= @query_log_tags_format %>
  query_log_tags:                       <%= @query_log_tags %>
  query_log_tags_prepend_comment:       <%= @query_log_tags_prepend_comment %>

  pg_stat_statements_reset_at:          <%= @pg_stat_statements.reset_at %>
  pg_stat_statements_installed_version: <%= @pg_stat_statements.installed_version %>
  pg_stat_statements_default_version:   <%= @pg_stat_statements.default_version %>
  </pre>
</details>

<h1>Outliers</h1>

<% if @table_filter.present? %>
  <article aria-label="Table filter active">
    <p>
      Showing queries for table: <strong><%= @table_filter %></strong>
      <%= link_to "Clear filter", database_pg_stat_statements_outliers_path(@database) %>
    </p>
  </article>
<% end %>

<% if @outliers.present? %>
  <table>
    <thead>
      <tr>
        <th width="30">Execution Time</th>
        <th>Query</th>
        <th>Comment</th>
        <th>Calls</th>
      </tr>
    </thead>
    <tbody>
      <% @outliers.each do |outlier| %>
        <tr>
          <td>
            <%= ActiveSupport::Duration.parse(outlier["total_exec_time"]).to_s %>
          </td>
          <td>
            <pre>
              <%= strip_sqlcommenter(outlier["query"]).squish %>
            </pre>
          </td>
          <td>
            <% if (comment = extract_comment(outlier["query"])) %>
              <% sqlcommenter_to_hash(comment).each do |key, value| %>
                <%= key %>: <%= value %><br>
              <% end %>
            <% end %>
          </td>
          <td>
            <%= outlier["ncalls"] %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No outliers found.</p>
<% end %>

<ol>
<% @controllers_actions.each do |controller, actions| %>
  <li>
    <% actions.each do |action| %>
      <b><%= controller %>#<%= action %></b><br>
      <pre>$$%/*action='<%= action %>',application='<%= @application %>',namespaced_controller='<%= ERB::Util.url_encode(controller) %>'*/%$$</pre>
    <% end %>
  </li>
<% end %>
</ol>
