<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
  <h1 style="margin: 0;"><%= @job_class %></h1>
  <%= link_to "Back to Jobs", jobs_path, role: "button", class: "secondary outline" %>
</div>

<% if @outliers_by_db.empty? %>
  <article aria-label="No queries found">
    <header>No queries found for this job</header>
    <p>This could mean:</p>
    <ul>
      <li>The job hasn't executed any database queries recently</li>
      <li>pg_stat_statements statistics have been reset</li>
      <li>The job queries are not in the top outliers</li>
    </ul>
  </article>
<% else %>
  <% all_outliers = @outliers_by_db.flat_map { |db, outliers| outliers.map { |o| o.merge("database" => db) } } %>
  <% max_calls = all_outliers.map { |o| o["ncalls"].to_s.gsub(/[^0-9]/, "").to_i }.max %>

  <table>
    <thead>
      <tr>
        <th style="width: 50px; text-align: center;" title="Call intensity">Calls</th>
        <th style="width: 100px;">Time</th>
        <% if @outliers_by_db.size > 1 %>
          <th style="width: 100px;">Database</th>
        <% end %>
        <th>Query</th>
        <th style="width: 40px; text-align: center;" title="SQLcommenter metadata"></th>
      </tr>
    </thead>
    <tbody>
      <% all_outliers.each do |outlier| %>
        <% comment = extract_comment(outlier["query"]) %>
        <% calls_num = outlier["ncalls"].to_s.gsub(/[^0-9]/, "").to_i %>
        <tr>
          <td style="vertical-align: top; white-space: nowrap; font-family: monospace; letter-spacing: -2px;" title="<%= outlier["ncalls"] %> calls">
            <%= intensity_bar(calls_num, max_calls) %>
          </td>
          <td style="vertical-align: top; font-size: 13px; white-space: nowrap;">
            <strong><%= format_duration(outlier["total_exec_time"]) %></strong><br>
            <span style="color: var(--pico-muted-color, #666);"><%= outlier["prop_exec_time"] %></span><br>
            <span style="color: var(--pico-muted-color, #666); font-size: 11px;">avg: <%= outlier["avg_exec_ms"] %>ms</span>
          </td>
          <% if @outliers_by_db.size > 1 %>
            <td style="vertical-align: top;">
              <%= outlier["database"].name %>
            </td>
          <% end %>
          <td style="vertical-align: top;">
            <code style="font-size: 12px; word-break: break-all; white-space: pre-wrap;"><%= strip_sqlcommenter(outlier["query"]).squish %></code>
          </td>
          <td style="text-align: center; vertical-align: top;">
            <% if comment %>
              <% comment_text = sqlcommenter_to_hash(comment).map { |k, v| "#{k}: #{CGI.unescape(v.to_s.gsub(/^'|'$/, ''))}" }.join("\n") %>
              <span title="<%= comment_text %>" style="cursor: help;">💬</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
