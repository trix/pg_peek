<div class="toolbar">
  <h1><code class="name"><%= @job_class %></code></h1>
  <%= link_to "← jobs", database_jobs_path(@database) %>
</div>

<% if @report.empty? %>
  <article aria-label="No queries found">
    <header>No queries found for this job</header>
    <p>This could mean:</p>
    <ul>
      <li>The job hasn't executed any database queries since statistics were last reset</li>
      <li>The job's queries are not among the top outliers</li>
    </ul>
  </article>
<% else %>
  <%= render "pg_peek/reports/report", report: @report %>
<% end %>
