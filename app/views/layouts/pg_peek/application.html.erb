<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <title>pg_peek</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "pg_peek/application", media: "all" %>
    <%= javascript_include_tag "pg_peek/application", defer: true %>
  </head>
  <body>
    <main>
      <% if flash[:notice] %><p class="notice"><%= flash[:notice] %></p><% end %>
      <% if flash[:alert] %><p class="alert"><%= flash[:alert] %></p><% end %>
      <nav>
        <ul>
          <li><%= link_to "pg_peek", databases_path, class: "wordmark" %></li>
        </ul>
        <ul>
          <% if @database %>
            <li><%= link_to "overview", database_path(@database) %></li>
            <li><%= link_to "queries", database_queries_path(@database) %></li>
            <li><%= link_to "endpoints", database_endpoints_path(@database) %></li>
            <li><%= link_to "jobs", database_jobs_path(@database) %></li>
            <li><%= link_to "tables", database_tables_path(@database) %></li>
            <li><%= link_to "indexes", database_indexes_path(@database) %></li>
            <li><%= link_to "activity", database_activity_path(@database) %></li>
            <li class="current-database">
              <% if switchable_databases.many? %>
                <span class="switcher">
                  <select data-switcher aria-label="Switch database">
                    <% switchable_databases.each do |candidate| %>
                      <option value="<%= switch_database_path(candidate) %>" <%= "selected" if candidate.name == @database.name %>><%= candidate.name %></option>
                    <% end %>
                  </select>
                </span>
              <% else %>
                <%= link_to @database.name, database_path(@database) %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </nav>

      <%= yield %>
    </main>

    <footer class="status">
      <span>pg_peek <%= PgPeek::VERSION %></span>
      <a href="https://github.com/trix/pg_peek" rel="noopener noreferrer">source</a>
      <button type="button" data-theme-toggle aria-label="Toggle theme" title="Press t to toggle">theme: light</button>
    </footer>
  </body>
</html>
